#filter {
    display: none;
}

#main {
    height: 1fr;
}

#sessions, #agents {
    width: 1fr;
    height: 100%;
}

#preview {
    width: 40%;
    height: 100%;
    border: round $accent;
    border-title-color: $accent;
    border-title-style: bold;
    padding: 0 1;
    overflow-x: hidden;
    overflow-y: hidden;
    text-wrap: nowrap;
    text-overflow: clip;
}

#empty {
    display: none;
    height: 1fr;
    content-align: center middle;
    color: $text-muted;
}

#hint {
    height: auto;
    padding: 0 1;
    color: $text-muted;
}

#sessionizer-hint {
    padding: 0 1;
    color: $text-muted;
}

ConfirmModal, NewSessionModal, RenameModal, HelpModal {
    align: center middle;
}

.modal-box {
    width: 60;
    max-width: 90%;
    height: auto;
    padding: 1 2;
    border: thick $accent;
    background: $surface;
}

HelpModal .modal-box {
    width: 72;
}

.modal-title {
    text-style: bold;
    margin-bottom: 1;
}

.modal-message {
    margin-bottom: 1;
}

.modal-hint {
    margin-top: 1;
    color: $text-muted;
}

.modal-error {
    color: $error;
    height: auto;
}

.modal-box Input {
    margin-bottom: 1;
}

.modal-buttons {
    height: auto;
    align-horizontal: right;
}

.modal-buttons Button {
    margin-left: 2;
}

#project-filter {
    margin: 0 1;
}
